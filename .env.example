# Copy this file to .env and fill in the values. Never commit .env.
# On the Windows PC, deploy\windows\install.ps1 creates .env for you.
# For development on your own computer, set DJANGO_DEBUG=True (a throwaway secret key is then allowed).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The app only listens on 127.0.0.1: no HTTPS. True only behind an HTTPS reverse proxy.
DJANGO_HTTPS=False
APP_PORT=8000

# Daily backups (manage.py backup_data): ideally a synced cloud folder (OneDrive, Google Drive...).
BACKUP_DIR=
BACKUP_KEEP_DAYS=30

# Windows only: folder of the Pango libraries installed with MSYS2 (needed for the PDF invoices).
WEASYPRINT_DLL_DIRECTORIES=

# Outgoing email (SMTP). Leave EMAIL_HOST empty to print emails to the console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
