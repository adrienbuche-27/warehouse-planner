# Copy this file to .env and fill in the values. Never commit .env.
# For local development, set DJANGO_DEBUG=True (a throwaway secret key is then allowed).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=stockage.example.be
CSRF_TRUSTED_ORIGINS=https://stockage.example.be

# Outgoing email (SMTP). Leave EMAIL_HOST empty to print emails to the console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
